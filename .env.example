# Copiar a .env.local y completar (nunca commitear .env.local)
NEXT_PUBLIC_SUPABASE_URL=https://ajsuskyeatgatbubctzl.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo backend (rutas API / kill switch / admin) — jamás exponer al navegador
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (checkout de suscripciones) — crear productos en el dashboard de
# Stripe y pegar aquí la secret key y los price IDs de cada plan
STRIPE_SECRET_KEY=
STRIPE_PRICE_ESSENTIAL=
STRIPE_PRICE_COMPLEX=
STRIPE_PRICE_APPS=

# Apps hermanas servidas bajo este dominio con un rewrite (next.config.ts).
# Cada una vive en su propio repo y su propia base de datos; el portal de
# admin les pide el resumen por HTTP con un secreto compartido.
#
# OJO: los rewrites se hornean en el BUILD, no al arrancar. Si añades o
# cambias una de estas URLs hay que volver a desplegar para que surta efecto.

# JuditoADS (repo Judito-Ads) → judomarketing.net/juditoads
JUDITOADS_URL=
JUDITOADS_ADMIN_TOKEN=

# Juditos, los asistentes de IA (repo AI-Assistants) → judomarketing.net/juditos
# JUDITOS_URL es el ORIGEN del deploy, sin el /juditos final.
JUDITOS_URL=
# El mismo valor que JUDITOS_ADMIN_TOKEN en el proyecto de Juditos.
JUDITOS_ADMIN_TOKEN=

# JudiMental (app de teléfono). No se sirve bajo judomarketing.net: aquí va el
# ORIGEN de su backend, sin prefijo de ruta. El portal solo la LEE (quién se
# registró y su avance) y le manda sillas de invitado.
JUDIMENTAL_URL=
JUDIMENTAL_ADMIN_TOKEN=
