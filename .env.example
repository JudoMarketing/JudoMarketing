# Copiar a .env.local y completar (nunca commitear .env.local)
NEXT_PUBLIC_SUPABASE_URL=https://ajsuskyeatgatbubctzl.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo backend (rutas API / kill switch / admin) — jamás exponer al navegador
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (checkout de suscripciones) — crear productos en el dashboard de
# Stripe y pegar aquí la secret key y los price IDs de cada plan
STRIPE_SECRET_KEY=
STRIPE_PRICE_ESSENTIAL=
STRIPE_PRICE_COMPLEX=
STRIPE_PRICE_APPS=
# Avisos de cobros fallidos de suscripciones a admin@judomarketing.net.
# Stripe → Developers → Webhooks → endpoint https://www.judomarketing.net/api/stripe/webhook
# (eventos invoice.payment_failed y customer.subscription.deleted) → "Signing secret".
STRIPE_WEBHOOK_SECRET=

# Apps hermanas servidas bajo este dominio con un rewrite (next.config.ts).
# Cada una vive en su propio repo y su propia base de datos; el portal de
# admin les pide el resumen por HTTP con un secreto compartido.
#
# OJO: los rewrites se hornean en el BUILD, no al arrancar. Si añades o
# cambias una de estas URLs hay que volver a desplegar para que surta efecto.

# JuditoADS (repo Judito-Ads) → judomarketing.net/juditoads
JUDITOADS_URL=
JUDITOADS_ADMIN_TOKEN=

# Juditos, los asistentes de IA (repo AI-Assistants) → judomarketing.net/juditos
# JUDITOS_URL es el ORIGEN del deploy, sin el /juditos final.
JUDITOS_URL=
# El mismo valor que JUDITOS_ADMIN_TOKEN en el proyecto de Juditos.
JUDITOS_ADMIN_TOKEN=

# Google Analytics del propio judomarketing.net (el G-XXXX del flujo web en
# GA4 → Admin → Data streams). Sin la variable no se carga la etiqueta.
NEXT_PUBLIC_GA_ID=

# Datos de Google (Search Console + Analytics) en el portal de admin.
# El contenido completo del archivo .json de la cuenta de servicio, tal cual.
# Los pasos están en docs/google-conexion.md.
GOOGLE_SERVICE_ACCOUNT_JSON=

# JudiMental (app de teléfono). No se sirve bajo judomarketing.net: aquí va el
# ORIGEN de su backend, sin prefijo de ruta. El portal solo la LEE (quién se
# registró y su avance) y le manda sillas de invitado.
JUDIMENTAL_URL=
JUDIMENTAL_ADMIN_TOKEN=

# Prospección por correo (docs/LEADS.md). Cada dos días una sesión automática
# busca negocios por código postal y les escribe; el sitio guarda, envía y
# procesa las bajas. La sesión solo conoce LEADS_SECRET.
# Secreto compartido con la sesión y llave de los enlaces de baja. Largo y
# aleatorio: openssl rand -base64 32
LEADS_SECRET=
# Google Cloud → APIs → "Places API (New)" → credencial tipo API key, restringida a esa API.
GOOGLE_PLACES_API_KEY=
# 'prueba' (todo va a LEADS_CORREO_PRUEBA, nada al negocio) o 'real'.
LEADS_MODO=prueba
LEADS_CORREO_PRUEBA=admin@judomarketing.net
# Remitente. Tiene que ser un alias "Send mail as" de la cuenta SMTP_USER.
LEADS_FROM="Junior Osorio, Judo Marketing" <info@judomarketing.net>
LEADS_REPLY_TO=admin@judomarketing.net
# Tope de correos reales por día.
LEADS_MAX_DIA=20
